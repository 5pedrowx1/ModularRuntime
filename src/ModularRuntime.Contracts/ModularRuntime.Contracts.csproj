<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>ModularRuntime.Contracts</PackageId>
    <Description>The ModularRuntime plugin API (contracts shared by the host and plugins): IPlugin, IPluginContext, the event bus, service registry, extension points, resource ownership, JSON payloads. Shared with the host at run time; plugins reference it but never package it.</Description>
    <PackageTags>modularruntime;plugins</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
