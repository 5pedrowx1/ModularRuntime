<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Identifies the active palette; ThemeService locates this dictionary by this key. -->
    <sys:String x:Key="ThemeName">Light</sys:String>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F8" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#ECEDF2" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F1F5" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E7E8EE" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#DFE0E6" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C7C9D1" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1B20" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5D68" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8C8F9A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3D5CE0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F6CEB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3350C8" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E3E8FD" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8C5A" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#DDF3E8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A86A00" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FBEED2" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C8323C" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FBE1E3" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1F6FD1" />
    <SolidColorBrush x:Key="NeutralSubtleBrush" Color="#ECEDF1" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2C4CC" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
    <!-- Native 1 px window border drawn by DWM on Windows 11 (see WindowAppearance). -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#C4C6CF" />
</ResourceDictionary>
