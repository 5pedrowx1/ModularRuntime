<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Identifies the active palette; ThemeService locates this dictionary by this key. -->
    <sys:String x:Key="ThemeName">Dark</sys:String>
    <!-- Neutral dark palette with a discreet blue accent. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16171B" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1C1D22" />
    <SolidColorBrush x:Key="CardBrush" Color="#222329" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#292A31" />
    <SolidColorBrush x:Key="ControlBrush" Color="#2A2B32" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#33343C" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2E2F36" />
    <SolidColorBrush x:Key="InputBrush" Color="#1B1C21" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#33343B" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#45464F" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEEF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A5B0" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E707B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6E8BFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#859DFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5C79EA" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#262E4D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0E1120" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4FC48F" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1D3329" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E5B65A" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3A3020" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F0727A" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#3D2326" />
    <SolidColorBrush x:Key="InfoBrush" Color="#6FB4FF" />
    <SolidColorBrush x:Key="NeutralSubtleBrush" Color="#2C2D34" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4B54" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
    <!-- Native 1 px window border drawn by DWM on Windows 11 (see WindowAppearance). -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A3B43" />
</ResourceDictionary>
