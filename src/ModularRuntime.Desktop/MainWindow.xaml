<Window x:Class="ModularRuntime.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ModularRuntime"
        Width="1240" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sidebar background spans the title bar for a continuous column -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0" />

        <!-- Title bar -->
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                <TextBlock Text="&#xEA86;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="ModularRuntime" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeRestore"
                    ToolTip="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize" />
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose"
                    ToolTip="Close (the daemon keeps running)" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Close" />
        </StackPanel>

        <!-- Sidebar -->
        <DockPanel Grid.Row="1" Margin="12,8,12,12" LastChildFill="True">
            <!-- Connection indicator -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Starting">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Stopping">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionState}" FontWeight="SemiBold" Margin="8,0,0,0" FontSize="12.5"
                                   AutomationProperties.Name="Connection state" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               TextTrimming="None" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding ConnectionState, Converter={StaticResource Match}, ConverterParameter=Disconnected|Error}">
                        <Button Content="Retry" Command="{Binding RetryCommand}" Style="{StaticResource SubtleButton}" Margin="0,0,6,0" />
                        <Button Content="Start daemon" Command="{Binding StartDaemonCommand}" Style="{StaticResource AccentButton}"
                                MinHeight="28" Padding="10,4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     AutomationProperties.Name="Navigation">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center" Width="22" />
                            <TextBlock Text="{Binding Title}" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page content -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding SelectedPage}" Focusable="False" Margin="28,4,28,24" />
    </Grid>
</Window>
