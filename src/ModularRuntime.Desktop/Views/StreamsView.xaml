<UserControl x:Class="ModularRuntime.Desktop.Views.StreamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModularRuntime.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,8,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" />
            <StackPanel>
                <TextBlock Text="Streams" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                    <Run Text="Buffered streams created by plugins and the host:" /> <Run Text="{Binding TotalCount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <TextBox Grid.Row="1" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12" Tag="Search streams, item types, producers"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search streams" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6"
                Visibility="{Binding State, Converter={StaticResource Match}, ConverterParameter=Ready}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STREAM" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="VERSION" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="2" Text="ITEM TYPE" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="3" Text="PRODUCER" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="4" Text="SUBSCRIBERS / WRITTEN" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource CaptionText}" />
                </Grid>
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Items}" AutomationProperties.Name="Streams">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding StreamId}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ItemType}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock Style="{StaticResource CaptionText}">
                                        <Run Text="buffer" /> <Run Text="{Binding DefaultCapacity, Mode=OneWay}" /> <Run Text="{Binding DefaultFullMode, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Owner.Display}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Style="{StaticResource BodyText}" VerticalAlignment="Center">
                                    <Run Text="{Binding SubscriberCount, Mode=OneWay}" /> <Run Text="/" /> <Run Text="{Binding Sequence, Mode=OneWay}" />
                                </TextBlock>
                                <Border Grid.Column="5" Style="{StaticResource Pill}">
                                    <Border.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Completed" />
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="Text" Value="Available" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Resources>
                                    <TextBlock />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <views:PageStateView Grid.Row="2" EmptyText="No streams are registered. Plugins create streams through the stream registry (plugin API 0.4)." />

        <ItemsControl Grid.Row="3" ItemsSource="{Binding SharedContracts}" Margin="0,12,0,0" AutomationProperties.Name="Shared contracts">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0">
                        <Run Text="Shared contract" /> <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas" /> <Run Text="{Binding Version, Mode=OneWay}" /> <Run Text="used by" /> <Run Text="{Binding Users, Mode=OneWay, Converter={StaticResource Join}}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
