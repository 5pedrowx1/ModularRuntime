<UserControl x:Class="ModularRuntime.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModularRuntime.Desktop.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="LogRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Timestamp, Converter={StaticResource LocalTime}, ConverterParameter=HH:mm:ss}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Level, Converter={StaticResource LevelShort}}" Style="{StaticResource LevelText}" FontSize="11" VerticalAlignment="Top" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" MaxHeight="36" />
                    <TextBlock Text="{Binding PluginId}" Style="{StaticResource CaptionText}"
                               Visibility="{Binding PluginId, Converter={StaticResource NullVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,8,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh"
                    Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" />
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource TitleText}" />
                <TextBlock Text="Live overview of the ModularRuntime daemon for this profile." Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Visibility="{Binding State, Converter={StaticResource Match}, ConverterParameter=Ready}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="4" Margin="-6,0">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="DAEMON" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status.State}" Style="{StaticResource MetricText}" FontSize="22" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0">
                            <Run Text="Version" /> <Run Text="{Binding Status.DaemonVersion, Mode=OneWay}" />
                            <Run Text="· pid" /> <Run Text="{Binding Status.ProcessId, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="UPTIME" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Uptime}" Style="{StaticResource MetricText}" FontSize="22" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Status.StartedAt, Converter={StaticResource LocalTime}, StringFormat=Since {0}}"
                                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="PLUGINS" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Status.PluginCount}" Style="{StaticResource MetricText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                            <Run Text="{Binding Status.RunningPluginCount, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" />
                            <Run Text="running ·" />
                            <Run Text="{Binding Status.FailedPluginCount, Mode=OneWay}" Foreground="{DynamicResource ErrorBrush}" />
                            <Run Text="failed" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="PLATFORM" Style="{StaticResource CaptionText}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Status.ServiceCount}" Style="{StaticResource SubtitleText}" MinWidth="26" />
                            <TextBlock Grid.Column="1" Text="services" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{Binding Status.ExtensionPointCount}" Style="{StaticResource SubtitleText}" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="extension points" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="{Binding Status.SubscriptionCount}" Style="{StaticResource SubtitleText}" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="event subscriptions" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Margin="0,10,0,14">
                <Run Text="Profile:" /> <Run Text="{Binding Status.ProfileDirectory, Mode=OneWay}" />
                <Run Text="  ·  Runtime" /> <Run Text="{Binding Status.RuntimeId, Mode=OneWay}" />
                <Run Text="  ·  Clients:" /> <Run Text="{Binding Status.Clients.Count, Mode=OneWay}" />
            </TextBlock>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Recent activity" Style="{StaticResource SubtitleText}" Margin="0,0,0,10" />
                        <TextBlock DockPanel.Dock="Top" Text="No recent activity." Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding RecentActivity.Count, Converter={StaticResource PositiveVis}, ConverterParameter=!}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource LogRow}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Recent warnings and errors" Style="{StaticResource SubtitleText}" Margin="0,0,0,10" />
                        <TextBlock DockPanel.Dock="Top" Text="No warnings or errors." Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding RecentErrors.Count, Converter={StaticResource PositiveVis}, ConverterParameter=!}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentErrors}" ItemTemplate="{StaticResource LogRow}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <views:PageStateView Grid.Row="1" />
    </Grid>
</UserControl>
