<UserControl x:Class="ModularRuntime.Desktop.Views.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Package operations in progress. DataContext: PackageOperationsTracker (shared by Store and Plugins). -->
    <ItemsControl ItemsSource="{Binding Operations}" AutomationProperties.Name="Package operations">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                                <Run Text="{Binding Title, Mode=OneWay}" /> <Run Text="·" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Run Text="{Binding Stage, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource NeutralSubtleBrush}" BorderThickness="0"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}" />
                            <ProgressBar Style="{StaticResource LoadingBar}" Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
