<UserControl x:Class="ModularRuntime.Desktop.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModularRuntime.Desktop.Views"
             x:Name="Page">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,8,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" AutomationProperties.Name="Refresh" />
                <Button Command="{Binding StopAllCommand}" Margin="0,0,8,0" AutomationProperties.Name="Stop all">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Stop all" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StartAllCommand}" Style="{StaticResource AccentButton}" AutomationProperties.Name="Start all">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Start all" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Plugins" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="installed ·" />
                    <Run Text="{Binding RunningCount, Mode=OneWay}" /> <Run Text="running ·" />
                    <Run Text="{Binding FailedCount, Mode=OneWay}" /> <Run Text="failed" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Package operations (for example a removal) -->
        <views:OperationsView Grid.Row="1" DataContext="{Binding Operations}" />

        <!-- Result banner -->
        <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="{Binding OperationMessage, Converter={StaticResource NullVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OperationFailed}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24"
                        Command="{Binding DismissMessageCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
                <TextBlock Text="{Binding OperationMessage}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Search and state filters -->
        <DockPanel Grid.Row="3" Margin="0,0,0,12" Visibility="{Binding State, Converter={StaticResource Match}, ConverterParameter=Ready}">
            <TextBox DockPanel.Dock="Left" Width="280" Tag="Search by name or ID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search plugins" />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip}" Content="All" GroupName="PluginState"
                             IsChecked="{Binding StateFilter, Converter={StaticResource EnumBool}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Chip}" Content="Running" GroupName="PluginState"
                             IsChecked="{Binding StateFilter, Converter={StaticResource EnumBool}, ConverterParameter=Running}" />
                <RadioButton Style="{StaticResource Chip}" Content="Ready" GroupName="PluginState"
                             IsChecked="{Binding StateFilter, Converter={StaticResource EnumBool}, ConverterParameter=Ready}" />
                <RadioButton Style="{StaticResource Chip}" Content="Stopped" GroupName="PluginState"
                             IsChecked="{Binding StateFilter, Converter={StaticResource EnumBool}, ConverterParameter=Stopped}" />
                <RadioButton Style="{StaticResource Chip}" Content="Failed" GroupName="PluginState"
                             IsChecked="{Binding StateFilter, Converter={StaticResource EnumBool}, ConverterParameter=Failed}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="4" Visibility="{Binding State, Converter={StaticResource Match}, ConverterParameter=Ready}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Installed plugins -->
            <Border Style="{StaticResource Card}" Padding="6">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,6,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PLUGIN" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="VERSION" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="3" Text="TRUST" Style="{StaticResource CaptionText}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="No plugins match the current filter." Style="{StaticResource SecondaryText}" Margin="12"
                               Visibility="{Binding Items.Count, Converter={StaticResource PositiveVis}, ConverterParameter=!}" />
                    <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Installed plugins">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="12" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource ErrorBrush}" ToolTip="{Binding LastErrorCode}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource StatePill}">
                                        <TextBlock Text="{Binding State}" Style="{StaticResource StatePillText}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TrustPill}" ToolTip="{Binding TrustExplanation}">
                                        <TextBlock Text="{Binding TrustLabel}" Style="{StaticResource TrustPillText}" />
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ProgressBar Style="{StaticResource LoadingBar}" Width="20" VerticalAlignment="Center" Margin="0,0,4,0"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Command="{Binding StartCommand}"
                                                ToolTip="Start" AutomationProperties.Name="Start plugin"
                                                Visibility="{Binding CanBeStarted, Converter={StaticResource BoolVis}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RestartCommand}"
                                                ToolTip="Restart" AutomationProperties.Name="Restart plugin"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Command="{Binding StopCommand}"
                                                ToolTip="Stop" AutomationProperties.Name="Stop plugin"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Details and diagnostics -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Select a plugin to manage it and see its trust state, package, details, owned resources, and last error."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding Selected, Converter={StaticResource NullVis}, ConverterParameter=!}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding Selected.Id, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12" />

                            <!-- Lifecycle -->
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Start" Command="{Binding StartSelectedCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8" MinWidth="76"
                                        AutomationProperties.Name="Start selected plugin" />
                                <Button Content="Stop" Command="{Binding StopSelectedCommand}" Margin="0,0,8,8" MinWidth="76"
                                        AutomationProperties.Name="Stop selected plugin" />
                                <Button Content="Restart" Command="{Binding RestartSelectedCommand}" Margin="0,0,8,8" MinWidth="76"
                                        AutomationProperties.Name="Restart selected plugin" />
                            </WrapPanel>

                            <!-- Trust and package -->
                            <Border DataContext="{Binding Selected}" Style="{StaticResource TrustPill}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TrustLabel}" Style="{StaticResource TrustPillText}" />
                            </Border>
                            <TextBlock Text="{Binding Selected.TrustExplanation}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,10" />
                            <Border Background="{DynamicResource ErrorSubtleBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding Selected.IsRevoked, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Revocation warning">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}" TextTrimming="None"
                                           Text="{Binding Selected.RevocationReason, StringFormat=Revoked by the official registry: {0}}" />
                            </Border>

                            <StackPanel DataContext="{Binding SelectedPackage}" Visibility="{Binding Converter={StaticResource NullVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Source" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="Signing key" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SigningKeyId, TargetNullValue=none}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Text="Files" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileCount}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Text="Package SHA-256" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PackageSha256, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Text="Installed" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstalledAt, Converter={StaticResource LocalTime}}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Text="Last check" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,3" TextWrapping="Wrap" TextTrimming="None"
                                               Text="{Binding LastVerification.Message, TargetNullValue=Not checked since the daemon started}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LastVerification.Problems}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource BodyText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AvailableVersion, StringFormat=Version {0} is available in the Store (Updates).}" Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" Visibility="{Binding AvailableVersion, Converter={StaticResource NullVis}}" />
                            </StackPanel>

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Verify integrity" Command="{Binding VerifyCommand}" Margin="0,0,8,8" AutomationProperties.Name="Verify integrity" />
                                <Button Content="Remove…" Command="{Binding RemoveSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Remove" />
                            </WrapPanel>

                            <!-- Engine details and diagnostics -->
                            <StackPanel DataContext="{Binding Details}" Visibility="{Binding Converter={StaticResource NullVis}}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="State" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding Summary.State}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="Version" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.Version}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Text="Instance" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Summary.InstanceId, Mode=OneWay, TargetNullValue=none}" Style="{StaticResource ReadOnlyText}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Text="API version" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApiVersion}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Text="Start order" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.StartOrder}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Text="Entry type" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EntryType, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="6" Text="Started" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Summary.StartedAt, Converter={StaticResource LocalTime}}" Style="{StaticResource BodyText}" Margin="0,3" />
                                    <TextBlock Grid.Row="7" Text="Stopped" Style="{StaticResource CaptionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Summary.StoppedAt, Converter={StaticResource LocalTime}}" Style="{StaticResource BodyText}" Margin="0,3" />
                                </Grid>

                                <TextBlock Text="Owned resources" Style="{StaticResource SubtitleText}" FontSize="13.5" Margin="0,18,0,6" />
                                <TextBlock Text="None (the plugin is not running, or created no resources)." Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="{Binding Resources.Count, Converter={StaticResource PositiveVis}, ConverterParameter=!}" />
                                <ItemsControl ItemsSource="{Binding Resources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Pill}" Padding="6,1">
                                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding LastError, Converter={StaticResource NullVis}}" Margin="0,18,0,0">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Copy"
                                                Command="{Binding DataContext.CopyDiagnosticCommand, ElementName=Page}" AutomationProperties.Name="Copy diagnostic" />
                                        <TextBlock Text="Last error" Style="{StaticResource SubtitleText}" FontSize="13.5" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border Background="{DynamicResource ErrorSubtleBrush}" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None">
                                                <Run Text="{Binding LastError.Code, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="·" /> <Run Text="{Binding LastError.Operation, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBox Text="{Binding LastError.Message, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,4,0,0" />
                                            <TextBox Text="{Binding LastError.Diagnostic.Detail, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,8,0,0" MaxHeight="220"
                                                     VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextSecondaryBrush}"
                                                     Visibility="{Binding LastError.Diagnostic, Converter={StaticResource NullVis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <views:PageStateView Grid.Row="4" EmptyText="No plugins are installed. Open the Store to discover official plugins or install one from a ZIP file." />
    </Grid>
</UserControl>
