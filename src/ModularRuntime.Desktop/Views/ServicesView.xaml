<UserControl x:Class="ModularRuntime.Desktop.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModularRuntime.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,8,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" />
            <StackPanel>
                <TextBlock Text="Services" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                    <Run Text="Registered by plugins and the host:" /> <Run Text="{Binding TotalCount, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <TextBox Grid.Row="1" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12" Tag="Search services, providers, operations"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search services" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6"
                Visibility="{Binding State, Converter={StaticResource Match}, ConverterParameter=Ready}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SERVICE" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="VERSION" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="2" Text="OPERATIONS" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="3" Text="PROVIDER" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource CaptionText}" />
                </Grid>
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Items}" AutomationProperties.Name="Services">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ServiceId}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Operations, Converter={StaticResource Join}}" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Grid.Column="3" Text="{Binding Owner.Display}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                <Border Grid.Column="4" Style="{StaticResource Pill}">
                                    <Border.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Unavailable" />
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="Text" Value="Available" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Resources>
                                    <TextBlock />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <views:PageStateView Grid.Row="2" EmptyText="No services are registered. Plugins register services through the service registry." />
    </Grid>
</UserControl>
