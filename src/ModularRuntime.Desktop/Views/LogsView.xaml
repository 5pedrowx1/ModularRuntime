<UserControl x:Class="ModularRuntime.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,8,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="0,0,16,0" />
                <Button Command="{Binding PauseCommand}" Margin="0,0,8,0" MinWidth="96">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                            <Setter Property="Content" Value="Pause" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="Resume" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Clear view" Command="{Binding ClearCommand}" ToolTip="Clears this window only; the daemon keeps its logs." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Logs" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                    <Run Text="Live stream from the daemon ·" /> <Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="entries in this view" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="280" Tag="Search messages and diagnostics" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     AutomationProperties.Name="Search logs" />
            <ComboBox Margin="10,0,0,0" Width="140" ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel}"
                      AutomationProperties.Name="Minimum level" ToolTip="Minimum level" />
            <ComboBox Margin="10,0,0,0" Width="260" ItemsSource="{Binding PluginFilters}" SelectedItem="{Binding PluginFilter}"
                      AutomationProperties.Name="Plugin filter" />
        </StackPanel>

        <!-- Banners -->
        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,10"
                    Visibility="{Binding State, Converter={StaticResource Match}, ConverterParameter=Disconnected}">
                <TextBlock Text="Disconnected: these are the last entries received. The stream resumes and fills the gap after reconnection."
                           Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
            </Border>
            <Border Background="{DynamicResource NeutralSubtleBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,10"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource BodyText}">
                    <Run Text="Paused —" /> <Run Text="{Binding PendingCount, Mode=OneWay}" /> <Run Text="new matching entries are buffered. Resume to show them." />
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Entries -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="EntriesList" Style="{StaticResource RowList}" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                     VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Log entries">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource LevelText}" />
                            <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding PluginId, StringFormat=[{0}]}" Style="{StaticResource MonoText}"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                                       Visibility="{Binding PluginId, Converter={StaticResource NullVis}}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Text="{Binding Message}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{DynamicResource ErrorBrush}" ToolTip="Has diagnostic details"
                                           Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Details -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" MaxHeight="220"
                Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyCommand}" Style="{StaticResource SubtleButton}" />
                    <TextBlock Text="Entry details" Style="{StaticResource SubtitleText}" FontSize="13.5" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox Text="{Binding Selected.FullText, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" FontFamily="{StaticResource MonoFont}"
                         FontSize="12" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
