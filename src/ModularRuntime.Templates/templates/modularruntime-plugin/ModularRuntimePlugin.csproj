<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Plugin layout: copies package dependencies to the output and writes the deps.json the loader uses. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Keep in sync with "version" in plugin.json (dotnet modularruntime validate warns otherwise). -->
    <Version>1.0.0</Version>
    <!-- The identifier-safe project name: must match entryAssembly and entryType in plugin.json. -->
    <AssemblyName>ModularRuntimePlugin</AssemblyName>
    <RootNamespace>ModularRuntimePlugin</RootNamespace>
    <!--
      packages.lock.json pins every NuGet dependency with its content hash. Official review requires
      it: the controlled build restores in locked mode exactly what was reviewed. Commit it.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ModularRuntime.Sdk brings ModularRuntime.Contracts (the plugin API). Contracts is shared with
      the host at run time: "dotnet modularruntime pack" never packages it. Do not reference
      ModularRuntime.Engine, Loader, or Daemon from a plugin.
    -->
    <PackageReference Include="ModularRuntime.Sdk" Version="MODULARRUNTIME_SDK_VERSION" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
